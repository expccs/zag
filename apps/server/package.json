{
  "name": "@zag/server",
  "version": "0.1.0",
  "private": true,
  "description": "ZAG Socket.IO server: the only runtime process",
  "type": "commonjs",
  "main": "./dist/bootstrap.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/bootstrap.ts",
    "start": "node dist/bootstrap.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write ."
  },
  "dependencies": {
    "@zag/protocol": "*",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@zag/config": "*",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

{
  "name": "@zag/server",
  "version": "0.1.0",
  "private": true,
  "description": "ZAG Socket.IO server: the only runtime process",
  "type": "commonjs",
  "main": "./dist/bootstrap.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/bootstrap.ts",
    "start": "node dist/bootstrap.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test --test-timeout=20000 'src/**/*.test.ts'",
    "lint": "eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier --write .",
    "ccs:probe": "tsx --env-file-if-exists=../../.env scripts/ccs-probe.ts"
  },
  "dependencies": {
    "@zag/protocol": "*",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsyringe": "^4.10.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@zag/config": "*",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}

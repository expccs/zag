# ---- apps/server ----
PORT=8080
# origin сайта (через запятую); пусто — CORS запрещён для всех чужих origin
ALLOWED_ORIGINS=http://localhost:5173
# live | dry-run (читает состояние, команды только логирует) | offline (без сети)
# по умолчанию live; вне offline обязательны CCS_LOGIN и CCS_PASSWORD
CCS_MODE=offline
CCS_URL=https://admin.expolightcontrols.net
CCS_LOGIN=
CCS_PASSWORD=
# группа STATE и свичи-флаги: по умолчанию константы ZAG из
# apps/server/src/ccs-ids.ts (docs/backend/ccs-ids.md); задавать только
# чтобы переопределить
# CCS_STATE_GROUP=6aef145253257f190d66c47b
# CCS_PROGRAM_TECH_PAUSE=qduuwcanagbl
# CCS_PROGRAM_INTERACTIVE=qxcsxqatyupx
# CCS_PROGRAM_LOCATION_RESTRICTION=azpuqosabwug
# CCS_PROGRAM_SCHEDULE=edbyrttglacr
# кнопки «Public app controls» (fade / session start WITH_PARAMS, session
# end / idle COMMAND): по умолчанию константы ZAG из ccs-ids.ts; задавать
# только чтобы переопределить (пустое CCS_CONTROLS_GROUP= выключает кнопки)
# CCS_CONTROLS_GROUP=6aef0c3e53257f190d66c477
# CCS_PROGRAM_SESSION_START=ospyruigxyop
# CCS_PROGRAM_SESSION_END=fwzxaqlwzwbu
# CCS_PROGRAM_FADE=crcerfeeroxz
# CCS_PROGRAM_IDLE=ueplzvoyanld
# принудительные флаги поверх CCS, например interactive=true,schedule=false
STATE_OVERRIDES=
# очередь сеансов: длительность сеанса, fade перед каждым сеансом (отсчёт
# у пользователя + переход фасада), удержание места при разрыве — в мс
SESSION_MS=40000
FADE_MS=5000
DISCONNECT_GRACE_MS=10000
# как часто всем ждущим повторно шлётся их место (синхронизация таймеров)
QUEUE_SYNC_MS=5000
# геозона (действует при флаге locationRestriction): радиус вокруг фасада,
# максимальный допуск по точности GPS, сколько ждать первую позицию от
# телефона после подключения (потом geo:update missing) — в метрах / мс
GEO_RADIUS_M=100
GEO_ACCURACY_TOLERANCE_M=30
GEO_SAMPLE_TIMEOUT_MS=5000
# центр зоны lat,lng; по умолчанию координаты из логина CCS (в offline —
# 0,0, задавать для локальной проверки)
# GEO_CENTER=49.8397,24.0297
# TouchDesigner: по умолчанию ws://10.11.68.104:82 (константа TD_DEFAULT_URL,
# сервер бесконечно переподключается раз в 5 с); в CCS_MODE=offline по
# умолчанию выключен (поток только в лог). Задавать только чтобы
# переопределить
# TD_WS_URL=ws://10.11.68.104:82
TD_PING_INTERVAL_MS=30000

# ---- apps/web (вшивается при сборке) ----
# пусто = тот же origin, /socket.io/ проксирует nginx или vite dev-proxy
VITE_SOCKET_URL=
# true — показывать приложение и на планшете/десктопе (только для разработки);
# иначе там заглушка «лише з телефону»
# VITE_ANY_DEVICE=true
